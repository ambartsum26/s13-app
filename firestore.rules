rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'fJT9srxZezNyAVC1NO2Rm6jdK4G3';
    }

    function validMapUrl(data) {
      return !('mapUrl' in data)
        || (data.mapUrl is string
          && data.mapUrl.size() <= 2048
          && (data.mapUrl == ''
            || data.mapUrl == '#'
            || data.mapUrl.matches('https?://.*')));
    }

    function validCity(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && validMapUrl(data);
    }

    function validTerritory(data) {
      return data.cityId is string
        && data.cityId.size() > 0
        && (data.number is string || data.number is int)
        && (!('russianSpeakers' in data)
          || (data.russianSpeakers is int && data.russianSpeakers >= 0))
        && (!('history' in data)
          || (data.history is list && data.history.size() <= 500))
        && validMapUrl(data);
    }

    function validPublisher(data) {
      return data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 200
        && (!('nameKey' in data) || data.nameKey is string)
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('gender' in data)
          || data.gender == 'male'
          || data.gender == 'female');
    }

    match /cities/{cityId} {
      allow read: if isOwner();
      allow create, update: if isOwner() && validCity(request.resource.data);
      allow delete: if isOwner();
    }

    match /territories/{territoryId} {
      allow read: if isOwner();
      allow create, update: if isOwner() && validTerritory(request.resource.data);
      allow delete: if isOwner();
    }

    match /publishers/{publisherId} {
      allow read: if isOwner();
      allow create, update: if isOwner() && validPublisher(request.resource.data);
      allow delete: if isOwner();
    }

    match /appLocks/{lockId} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.revision is int
        && request.resource.data.revision >= 0;
      allow delete: if isOwner();
    }

    match /appMigrations/{documentId} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
