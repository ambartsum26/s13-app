{
  "name": "s13-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i tailwind.input.css -o tailwind.generated.css --minify",
    "build:js": "node scripts/build-production.mjs",
    "build": "npm run build:css && npm run build:js",
    "test": "node scripts/run-tests.mjs",
    "check:rules": "firebase emulators:exec --only firestore --project demo-s13-app \"echo Firestore rules compiled\""
  },
  "dependencies": {
    "firebase": "12.18.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "firebase-tools": "15.29.0",
    "tailwindcss": "3.4.17"
  }
}
